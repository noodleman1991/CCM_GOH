# ─────────────────────────────────────────────────────────────────────────────
# CCM Hub — environment template. Copy to `.env.local` and fill in real values.
# `.env` and `.env.local` are gitignored; this file is the committed reference.
# Features that depend on unset keys fail closed / show a disabled state — they
# never break the rest of the app.
#
# This file and the code are kept in step by lib/__tests__/env-manifest.test.ts:
# every `process.env.X` the app reads must have a line here, and every line
# here must be read by the app, a script, or a named dependency. Add a variable
# to the code and the test tells you to document it; retire one and the test
# tells you to remove it.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core (required; lib/env.ts asserts these at production boot) ---
DATABASE_URL=
# Payload CMS — a SEPARATE database on the same Neon project/branch as
# DATABASE_URL above, never the same one (Prisma's `prisma migrate reset`
# drops the schema it manages). See payload.config.ts. Must be named
# `payload_cms`; the import scripts refuse any other name, and refuse an
# unrecognised HOST unless run with --allow-production
# (scripts/payload-import/lib/runtime.ts).
# Both become REQUIRED the moment any CONTENT_BACKEND* switch below says
# `payload` (lib/env.ts REQUIRED_WHEN_PAYLOAD): payload.config.ts defaults
# them to "" and would otherwise fail on the first query, not at boot.
PAYLOAD_DATABASE_URL=
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# DEPRECATED — a third base URL, read only by the two legacy add-work pages
# (app/[locale]/(main)/dashboard/profile/edit/work/{,add}/page.tsx), which
# point local dev at production when it is set. Retired with those pages;
# leave it unset.
NEXT_PUBLIC_APP_URL=
# "production" enables indexing (robots) + production-only behaviors.
NEXT_PUBLIC_SITE_ENV=development
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-28
SANITY_API_READ_TOKEN=
# Read by the operator scripts only (scripts/*.mjs migrations and backfills);
# nothing in the app reads it.
SANITY_API_WRITE_TOKEN=
# Editor-scope operations: scripts, plus a presence check in the case-study
# submit route's diagnostics.
SANITY_API_EDITOR_TOKEN=
# Verifies deliveries on /api/webhooks/sanity (fails closed when unset).
SANITY_WEBHOOK_SECRET=
# Set to "true" only during Sanity API-quota outages: unmounts the live-events
# stream (which otherwise retries every ~1s and burns quota). Content still
# renders; live invalidation falls back to timed revalidate.
SANITY_LIVE_DISABLED=
# Timed-revalidate window for Sanity reads, in seconds (default 3600). Raise to
# 86400 once the webhook is confirmed firing — it cuts timer-driven reads 24x
# with the webhook still giving instant updates (sanity/lib/live.ts).
SANITY_REVALIDATE_SECONDS=
# Same lever for Payload reads (lib/content/internal/payload-source.ts;
# default 3600).
PAYLOAD_REVALIDATE_SECONDS=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# The four NEXT_PUBLIC_CLERK_* URLs are read by @clerk/nextjs itself, not by
# our code (mergeNextClerkPropsWithEnv).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Content backend: Sanity today, Payload domain by domain ---------------
# lib/content/internal/backend.ts. Unset means `sanity`; the only other value
# is `payload`. Anything else refuses to boot rather than guess.
#
#   CONTENT_BACKEND             the default for every content domain
#   CONTENT_BACKEND_<DOMAIN>    overrides it for one domain, so each module
#                               can flip (and be reverted) on its own
#
# Every one of these has a NEXT_PUBLIC_ twin, consulted only when the
# server-only variable says nothing. Next inlines only NEXT_PUBLIC_* into the
# browser bundle, and lib/content/images.ts's imageUrl() runs inside client
# components — so a server on Payload with the browser still on Sanity would
# build two different <img src> values for one render (a hydration mismatch).
# When you flip `images`, set NEXT_PUBLIC_CONTENT_BACKEND_IMAGES (or the
# process-wide NEXT_PUBLIC_CONTENT_BACKEND) to the same value; images.ts
# warns once per process when the two disagree.
CONTENT_BACKEND=
NEXT_PUBLIC_CONTENT_BACKEND=
# The 17 per-domain switches the code answers to (lib/__tests__/env-manifest.test.ts
# keeps this list equal to the `activeBackend("…")` calls). Each has a
# NEXT_PUBLIC twin, read through a literal table in lib/content/internal/backend.ts
# so the browser bundle sees it; set the twin together with the server switch
# for any domain a client component renders (images above all).
CONTENT_BACKEND_ACCOUNT_DELETION=
NEXT_PUBLIC_CONTENT_BACKEND_ACCOUNT_DELETION=
CONTENT_BACKEND_CASE_STUDIES=
NEXT_PUBLIC_CONTENT_BACKEND_CASE_STUDIES=
CONTENT_BACKEND_DISCOVERY=
NEXT_PUBLIC_CONTENT_BACKEND_DISCOVERY=
CONTENT_BACKEND_ILLUSTRATIONS=
NEXT_PUBLIC_CONTENT_BACKEND_ILLUSTRATIONS=
CONTENT_BACKEND_IMAGES=
NEXT_PUBLIC_CONTENT_BACKEND_IMAGES=
CONTENT_BACKEND_LIVED_EXPERIENCES=
NEXT_PUBLIC_CONTENT_BACKEND_LIVED_EXPERIENCES=
CONTENT_BACKEND_METADATA=
NEXT_PUBLIC_CONTENT_BACKEND_METADATA=
CONTENT_BACKEND_NEWS=
NEXT_PUBLIC_CONTENT_BACKEND_NEWS=
CONTENT_BACKEND_ONBOARDING=
NEXT_PUBLIC_CONTENT_BACKEND_ONBOARDING=
CONTENT_BACKEND_OUTPUTS=
NEXT_PUBLIC_CONTENT_BACKEND_OUTPUTS=
CONTENT_BACKEND_PAGES=
NEXT_PUBLIC_CONTENT_BACKEND_PAGES=
CONTENT_BACKEND_REGIONS=
NEXT_PUBLIC_CONTENT_BACKEND_REGIONS=
CONTENT_BACKEND_SYSTEM=
NEXT_PUBLIC_CONTENT_BACKEND_SYSTEM=
CONTENT_BACKEND_TAXONOMY=
NEXT_PUBLIC_CONTENT_BACKEND_TAXONOMY=
CONTENT_BACKEND_TEXT=
NEXT_PUBLIC_CONTENT_BACKEND_TEXT=
CONTENT_BACKEND_UPLOADS=
NEXT_PUBLIC_CONTENT_BACKEND_UPLOADS=
CONTENT_BACKEND_USER_MANAGEMENT=
NEXT_PUBLIC_CONTENT_BACKEND_USER_MANAGEMENT=

# --- Cron + internal auth secrets ---
# Bearer secret for /api/cron/* (weekly digest, event reminders, retention).
# Destructive/mail-sending crons fail closed when unset.
CRON_SECRET=
# Bearer secret for the internal Algolia sync routes (/api/search/*/sync).
INTERNAL_SYNC_SECRET=
# Bearer secret for the search webhook routes (/api/search/*/webhook).
SEARCH_WEBHOOK_SECRET=
# Bearer key for POST /api/cache/revalidate (manual cache-tag purge). When
# unset the route refuses everything — except in `next dev`, where it skips
# the check entirely.
ADMIN_API_KEY=

# --- Data retention overrides (days; defaults 365 / 180) ---
RETENTION_DOWNLOAD_EVENT_DAYS=
RETENTION_NOTIFICATION_DAYS=

# --- Email (Resend) ---
RESEND_API_KEY=
# Newsletter audience. POST /api/newsletter answers 503 `newsletter_unavailable`
# until this and RESEND_API_KEY are both set; contacts are also removed from it
# on account erasure.
RESEND_AUDIENCE_ID=
# The verified sender for every outbound mail (case-study status, comment and
# notification emails). The domain connectingclimateminds.org IS verified in
# Resend; what production is missing is this variable. Unset, every sender
# falls back to Resend's sandbox address `onboarding@resend.dev`
# (lib/case-study-emails.ts, lib/comment-notifications.ts,
# lib/notifications/email.ts), which delivers only to the Resend account
# owner and 403s for everyone else — so mail to members has been failing
# silently. Set it to e.g. `Connecting Climate Minds <hub@connectingclimateminds.org>`.
CASE_STUDY_EMAIL_FROM=
# Where the editor "Report a problem" widget sends reports and what it sends
# from. Both default to values that only work under the sandbox sender
# (amit2@pm.me / the CASE_STUDY_EMAIL_FROM fallback chain above); once the
# variable above is set, point TO at the team inbox.
ISSUE_REPORT_EMAIL_TO=
ISSUE_REPORT_EMAIL_FROM=

# --- Search (Algolia) ---
# The code reads NEXT_PUBLIC_ALGOLIA_APP_ID (falling back to ALGOLIA_APP_ID),
# ALGOLIA_API_KEY (admin, server-only) and NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY
# (search-only, public).
NEXT_PUBLIC_ALGOLIA_APP_ID=
ALGOLIA_APP_ID=
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=
ALGOLIA_API_KEY=
# Verification affordance ONLY: when set, sync routes and Payload hooks WRITE
# to `<prefix>case_studies` etc. while reads keep naming the real indices, so
# a parity run can push real records at a scratch index. Unset everywhere;
# without it, live-index writes are allowed only on VERCEL_ENV=production
# (lib/algolia-indices.ts).
ALGOLIA_INDEX_PREFIX=
# The prefix the SITE SEARCHES (browser-visible). Set it to the same value
# as ALGOLIA_INDEX_PREFIX on a dev machine or preview so the search UI reads
# the scratch indices the sync routes just wrote; leave both unset in
# production (lib/algolia-indices.ts readIndexName).
NEXT_PUBLIC_ALGOLIA_INDEX_PREFIX=

# --- File storage: Cloudflare R2 (S3-compatible) ---
# The short `R2_*` names are the CANONICAL ones — `lib/r2.ts` (collaboration
# files) and `payload/storage/r2.ts` (CMS uploads) both read these first and
# only fall back to the long `CLOUDFLARE_R2_*` names below. lib/env.ts's boot
# report accepts either spelling. Same account, same credentials.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket collaboration files live in, prefix-routed members/ (private,
# presigned GET only) + public/.
R2_BUCKET=ccm-collab
# Public hostname for the public/ prefix; without it public files are served
# by presigned URL like private ones.
R2_PUBLIC_URL=

# Legacy fallbacks, still read (lib/r2.ts:16-20, payload/storage/r2.ts:30-60).
# Leave unset when the R2_* names above are set. BUCKET_NAME is the LAST
# fallback for the Payload upload bucket, so a value here would quietly pick
# the CMS's destination when PAYLOAD_R2_BUCKET and R2_BUCKET are both unset.
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_COLLAB_BUCKET=ccm-collab
CLOUDFLARE_R2_COLLAB_PUBLIC_URL=

# Where Payload CMS writes its 395 uploads (223 MB images + 395 MB files).
# OPTIONAL, and the only variable that decides the destination: unset, Payload
# falls back to R2_BUCKET and stores everything under the `cms/media` and
# `cms/files` key prefixes, which cannot collide with the collaboration
# layout's `public/` and `members/`. That is the current arrangement — CMS
# media shares `ccm-collab` under `cms/`. Set this to give the CMS its own
# bucket. With NEITHER set, config load fails loudly rather than defaulting to
# a live bucket.
PAYLOAD_R2_BUCKET=
# Public hostname of that bucket (a custom domain on the bucket in Cloudflare,
# or its r2.dev hostname for a preview), e.g. https://cdn.example.org. Set,
# images and files are served straight from R2 (free egress, Cloudflare cache)
# instead of through Payload's /payload-api/<slug>/file handler on a Vercel
# function, and next/image stops re-optimising them. Unset, nothing changes.
# NEXT_PUBLIC_ because the browser-side image loader recognises the host too.
# Setup steps: docs/migration/payload-production-runbook.md, "Media direct from R2".
NEXT_PUBLIC_PAYLOAD_MEDIA_PUBLIC_URL=

# File policy (lib/file-policy.ts; shared by case-study and collaboration uploads):
MAX_FILE_SIZE=50000000
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,ppt,pptx

# --- Third-party academic APIs (profile import) ---
# OpenAlex's polite pool asks callers to identify themselves by email
# (default hello@connectingclimateminds.org).
OPENALEX_MAILTO=
# ORCID public API base; override only to point at the sandbox
# (default https://pub.orcid.org/v3.0).
ORCID_API_BASE=

# --- Anonymous comment protection: Cloudflare Turnstile ---
# If unset, anonymous commenting is DISABLED (fail closed); signed-in still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting: Upstash Redis (optional) ---
# If unset, the Postgres fixed-window counter fallback is used instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error monitoring: Sentry (optional) ---
# next.config.mjs wraps the build with Sentry only when the DSN is set; the
# other three are what source-map upload needs at build time.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Build ---
# Leave unset. scripts/parity/render-diff.ts sets it per spawned build so the
# two backends' Turbopack caches never share a `.next` directory
# (next.config.mjs `distDir`).
NEXT_DIST_DIR=

# --- Feature flags (intermediate release) -------------------------------------
# The engagement program (messages, notifications, workspaces) is fully built;
# its infrastructure ships, but the UI is HIDDEN by default for the
# intermediate production release. Set to "true" to reveal it when ready.
# Absent/anything-else = hidden. This is the ONLY live feature flag.
NEXT_PUBLIC_FEATURE_ENGAGEMENT=

# --- Product analytics: PostHog (optional; EU cloud) ---
# Loads ONLY after the visitor accepts the analytics category in the cookie
# banner (lib/analytics/consent.ts), through the same-origin /ingest proxy
# (next.config.mjs). No autocapture, no session recording; the event taxonomy
# is lib/analytics/events.ts. Absent = the feature is off and reported as such.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Server-side events reuse the public key unless this is set.
POSTHOG_KEY=
# Set to 1 to load the SDK outside a production build (local verification).
NEXT_PUBLIC_POSTHOG_DEBUG=

# --- Traffic baseline: Plausible (cookieless, no key needed; components/cookie-consent/analytics-scripts.tsx) ---
