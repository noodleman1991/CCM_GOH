generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String            @id
  email                String?           @unique
  emailVerified        DateTime?
  username             String?           @unique
  image                String?
  bio                  String?
  role                 Role              @default(community_member)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  ageGroup             AgeGroup?
  city                 String?
  country              String?
  expertiseAreas       ExpertiseArea[]
  firstName            String?
  lastName             String?
  linkedinProfile      String?
  organization         String?
  personalWebsite      String?
  position             String?
  workBio              String?
  workTypes            WorkType[]
  isSearchable         Boolean           @default(true)
  profileVisibility    ProfileVisibility @default(PUBLIC)
  showEmail            Boolean           @default(false)
  showLocation         Boolean           @default(true)
  showSocialLinks      Boolean           @default(true)
  showWorkDetails      Boolean           @default(true)
  phoneNumber          String?
  phoneVerified        DateTime?
  showPhoneNumber      Boolean           @default(false)
  onboardingCompleted  Boolean           @default(false)
  onboardingStep       Int               @default(0)
  preferredLanguage    Language          @default(EN)
  welcomeMessageSeen   Boolean           @default(false)
  otherSocialLinks     Json?
  lastLoginAt          DateTime?
  profileCompleteness  Int               @default(0)

  // Domain-rich profile fields (K4) — all optional, climate x mental-health vocabulary.
  headline                 String?      // one-line self-description
  pronouns                 String?
  languages                String[]     @default([])
  focusTopics              String[]     @default([]) // climate x MH themes (CMS-curated)
  motivation               String?      // "what brought me here"
  openToCollaboration      Boolean      @default(false)
  lookingFor               String[]     @default([]) // mentorship/partners/funding/data/co-authors
  collaborationInterests   String?
  livedExperienceStatement String?      // sensitive — opt-in only
  showLivedExperience      Boolean      @default(false)
  orcidId                  String?      // academic credential + ORCID import

  accounts             Account[]
  createdContent       Content[]
  recentWork           RecentWork[]
  promptAnswers        ProfilePromptAnswer[]
  sessions             Session[]
  communityMemberships UserCommunity[]

  @@index([isSearchable])
  @@index([profileVisibility])
  @@index([lastLoginAt])
  @@index([profileCompleteness])
  @@index([country])
}

model Community {
  id           String                 @id @default(uuid())
  name         String
  description  String?
  type         CommunityType
  regionalName RegionalCommunityName?
  specialName  SpecialCommunityName?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  contents     Content[]
  members      UserCommunity[]
}

model UserCommunity {
  userId      String
  communityId String
  role        Role      @default(community_member)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([communityId])
}

model Content {
  id          String    @id @default(uuid())
  title       String
  body        String
  communityId String
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
  community   Community @relation(fields: [communityId], references: [id])

  @@index([communityId])
  @@index([authorId])
}

model RecentWork {
  id          String    @id @default(uuid())
  title       String
  description String
  link        String?
  isOngoing   Boolean   @default(false)
  startDate   DateTime
  endDate     DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Project upgrade (K4) — all optional, additive.
  role          String? // the person's role on the project
  collaborators String? // partners / collaborators, free text
  outcome       String? // outcome / impact line
  imageUrl      String? // cover image URL

  @@index([userId])
}

// K5 — a user's answer to a CMS-curated "Hinge-style" profile prompt.
// The prompt text lives in Sanity (profilePrompt doc); we store its id + answer.
model ProfilePromptAnswer {
  id        String   @id @default(uuid())
  userId    String
  promptId  String   // Sanity profilePrompt._id
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([userId])
}

model DownloadEvent {
  id           String   @id @default(cuid())
  reportId     String
  fileLanguage String
  userId       String?
  sessionId    String
  // Privacy: userAgent / referer / ipAddress intentionally removed — never read
  // by analytics, and indefinite IP storage was a GDPR liability.
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([reportId])
  @@map("download_events")
}

model report_metadata {
  id               String    @id
  sanityId         String    @unique
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
}

enum AgeGroup {
  UNDER_18
  ABOVE_18
}

enum Language {
  EN
  ES
  FR
  AR
}

enum WorkType {
  RESEARCH
  POLICY
  LIVED_EXPERIENCE_EXPERT
  NGO
  COMMUNITY_ORGANIZATION
  EDUCATION_TEACHING
}

enum ExpertiseArea {
  CLIMATE_CHANGE
  MENTAL_HEALTH
  HEALTH
  EDUCATION
  SOCIAL_JUSTICE
}

enum Role {
  community_member
  community_editor
  team_editor
  admin
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum CommunityType {
  REGIONAL
  SPECIAL
}

enum RegionalCommunityName {
  SUB_SAHARAN_AFRICA
  NORTHERN_AFRICA_AND_WESTERN_ASIA
  CENTRAL_AND_SOUTHERN_ASIA
  EASTERN_AND_SOUTH_EASTERN_ASIA
  LATIN_AMERICA_AND_THE_CARIBBEAN
  OCEANIA
  EUROPE_AND_NORTH_AMERICA
}

enum SpecialCommunityName {
  YOUTH
  INDIGENOUS
  FARMER_AND_FISHER
}
