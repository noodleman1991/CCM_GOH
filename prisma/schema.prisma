generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String            @id
  email                String?           @unique
  emailVerified        DateTime?
  username             String?           @unique
  image                String?
  bio                  String?
  role                 Role              @default(community_member)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  ageGroup             AgeGroup?
  city                 String?
  country              String?
  expertiseAreas       ExpertiseArea[]
  firstName            String?
  lastName             String?
  linkedinProfile      String?
  organization         String?
  personalWebsite      String?
  position             String?
  workBio              String?
  workTypes            WorkType[]
  isSearchable         Boolean           @default(true)
  profileVisibility    ProfileVisibility @default(PUBLIC)
  showEmail            Boolean           @default(false)
  showLocation         Boolean           @default(true)
  showSocialLinks      Boolean           @default(true)
  showWorkDetails      Boolean           @default(true)
  phoneNumber          String?
  phoneVerified        DateTime?
  showPhoneNumber      Boolean           @default(false)
  onboardingCompleted  Boolean           @default(false)
  onboardingStep       Int               @default(0)
  preferredLanguage    Language          @default(EN)
  // Optional link to this member's Sanity `author` document (content authorship
  // side). Set going forward (profile edit / Studio); no automatic backfill —
  // the `author` doc has no email to match on. One author ↔ one user.
  sanityPersonId       String?           @unique
  welcomeMessageSeen   Boolean           @default(false)
  otherSocialLinks     Json?
  lastLoginAt          DateTime?
  profileCompleteness  Int               @default(0)

  // Domain-rich profile fields (K4) — all optional, climate x mental-health vocabulary.
  headline                 String?      // one-line self-description
  pronouns                 String?
  languages                String[]     @default([])
  focusTopics              String[]     @default([]) // climate x MH themes (CMS-curated)
  motivation               String?      // "what brought me here"
  openToCollaboration      Boolean      @default(false)
  lookingFor               String[]     @default([]) // mentorship/partners/funding/data/co-authors
  collaborationInterests   String?
  livedExperienceStatement String?      // sensitive — opt-in only
  showLivedExperience      Boolean      @default(false)
  orcidId                  String?      // academic credential + ORCID import

  accounts             Account[]
  createdContent       Content[]
  recentWork           RecentWork[]
  promptAnswers        ProfilePromptAnswer[]
  sessions             Session[]
  communityMemberships UserCommunity[]

  // Comments & engagement (onDelete: Cascade on each FK side)
  comments             Comment[]
  commentReports       CommentReport[]
  reactions            Reaction[]
  mentions             Mention[]            @relation("MentionedUser")

  // Collaboration workspaces
  collaborationsOwned     Collaboration[]            @relation("CollaborationCreator")
  collaborationMemberships CollaborationMember[]
  collaborationFiles      CollaborationFile[]        @relation("CollaborationFileUploader")
  collaborationAnnotations CollaborationFileAnnotations[]

  // Notifications
  notifications          Notification[]             @relation("NotificationRecipient")
  notificationsActed     Notification[]             @relation("NotificationActor")
  notificationPreference NotificationPreference?

  // Direct messages
  conversationParticipations ConversationParticipant[]
  messagesSent               Message[]                 @relation("MessageSender")
  // Who may DM this user.
  allowMessagesFrom          MessagePrivacy            @default(EVERYONE)
  blocksMade                 UserBlock[]               @relation("Blocker")
  blockedBy                  UserBlock[]               @relation("Blocked")

  // Follows (region / theme / project)
  follows                    Follow[]

  // Join / contact requests
  joinRequests               JoinRequest[]
  contactRequestsSent        ContactRequest[]          @relation("ContactRequester")
  contactRequestsReceived    ContactRequest[]          @relation("ContactRecipient")

  @@index([isSearchable])
  @@index([profileVisibility])
  @@index([lastLoginAt])
  @@index([profileCompleteness])
  @@index([country])
}

model Community {
  id           String                 @id @default(uuid())
  name         String
  description  String?
  type         CommunityType
  regionalName RegionalCommunityName?
  specialName  SpecialCommunityName?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  contents     Content[]
  members      UserCommunity[]
}

model UserCommunity {
  userId      String
  communityId String
  role        Role      @default(community_member)
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, communityId])
  @@index([communityId])
}

model Content {
  id          String    @id @default(uuid())
  title       String
  body        String
  communityId String
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  author      User      @relation(fields: [authorId], references: [id])
  community   Community @relation(fields: [communityId], references: [id])

  @@index([communityId])
  @@index([authorId])
}

model RecentWork {
  id          String    @id @default(uuid())
  title       String
  description String
  link        String?
  isOngoing   Boolean   @default(false)
  startDate   DateTime
  endDate     DateTime?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Project upgrade (K4) — all optional, additive.
  role          String? // the person's role on the project
  collaborators String? // partners / collaborators, free text
  outcome       String? // outcome / impact line
  imageUrl      String? // cover image URL

  // Profile curation — owner can hide an item from their public profile and
  // pin one to the top. Additive (defaults preserve current behaviour).
  hidden Boolean @default(false)
  pinned Boolean @default(false)

  @@index([userId])
}

// K5 — a user's answer to a CMS-curated "Hinge-style" profile prompt.
// The prompt text lives in Sanity (profilePrompt doc); we store its id + answer.
model ProfilePromptAnswer {
  id        String   @id @default(uuid())
  userId    String
  promptId  String   // Sanity profilePrompt._id
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([userId])
}

model DownloadEvent {
  id           String   @id @default(cuid())
  reportId     String
  fileLanguage String
  userId       String?
  sessionId    String
  // Privacy: userAgent / referer / ipAddress intentionally removed — never read
  // by analytics, and indefinite IP storage was a GDPR liability.
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([reportId])
  @@map("download_events")
}

model report_metadata {
  id               String    @id
  sanityId         String    @unique
  downloadCount    Int       @default(0)
  lastDownloadedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
}

enum AgeGroup {
  UNDER_18
  ABOVE_18
}

enum Language {
  EN
  ES
  FR
  AR
}

enum WorkType {
  RESEARCH
  POLICY
  LIVED_EXPERIENCE_EXPERT
  NGO
  COMMUNITY_ORGANIZATION
  EDUCATION_TEACHING
}

enum ExpertiseArea {
  CLIMATE_CHANGE
  MENTAL_HEALTH
  HEALTH
  EDUCATION
  SOCIAL_JUSTICE
}

enum Role {
  community_member
  community_editor
  team_editor
  admin
}

enum ProfileVisibility {
  PUBLIC
  MEMBERS
  PRIVATE
}

enum CommunityType {
  REGIONAL
  SPECIAL
}

enum RegionalCommunityName {
  SUB_SAHARAN_AFRICA
  NORTHERN_AFRICA_AND_WESTERN_ASIA
  CENTRAL_AND_SOUTHERN_ASIA
  EASTERN_AND_SOUTH_EASTERN_ASIA
  LATIN_AMERICA_AND_THE_CARIBBEAN
  OCEANIA
  EUROPE_AND_NORTH_AMERICA
}

enum SpecialCommunityName {
  YOUTH
  INDIGENOUS
  FARMER_AND_FISHER
}

// ─── Comments + moderation + engagement ──────────────────────────────────────

enum CommentTargetType {
  caseStudy
  newsPost
  livedExperience
  collaborationThread
  collaborationFile
}

enum CommentStatus {
  PENDING
  VISIBLE
  DELETED_BY_AUTHOR
  REMOVED_BY_MOD
}

enum CommentFlagReason {
  BLOCKWORD
  WORDLIST
  REPORTED
}

enum CommentReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Comment {
  id          String            @id @default(cuid())
  targetType  CommentTargetType
  targetId    String
  // One level of nesting only; enforced by a CHECK (depth IN (0,1)) added in the
  // migration SQL. depth 0 = top-level, 1 = reply.
  depth       Int               @default(0)
  parentId    String?
  parent      Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]         @relation("CommentReplies")

  // Author: nullable for anonymous comments (name/email captured instead).
  authorId    String?
  author      User?             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorName  String?
  authorEmail String?

  body        String
  status      CommentStatus     @default(VISIBLE)

  // Optional page anchor for PDF (collaborationFile) comments.
  page        Int?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  flags       CommentFlag[]
  reports     CommentReport[]
  reactions   Reaction[]
  mentions    Mention[]

  @@index([targetType, targetId, status, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model CommentFlag {
  id        String            @id @default(cuid())
  commentId String
  comment   Comment           @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reason    CommentFlagReason
  term      String?
  createdAt DateTime          @default(now())

  @@index([commentId])
}

model CommentReport {
  id         String              @id @default(cuid())
  commentId  String
  comment    Comment             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User                @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String?
  status     CommentReportStatus @default(OPEN)
  createdAt  DateTime            @default(now())

  @@unique([commentId, reporterId])
  @@index([status])
}

model Reaction {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

model Mention {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([commentId, mentionedUserId])
  @@index([mentionedUserId])
}

// Durable rate-limit counter (fallback when Upstash is not configured).
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// ─── Collaboration workspaces ────────────────────────────────────────────────
// User-created free-form workspaces (separate from the fixed Community
// taxonomy). Membership mirrors the UserCommunity join: composite PK + per-row
// role + onDelete: Cascade. Named "Collaboration" to avoid the Sanity `project`
// document collision.

enum CollaborationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CollaborationVisibility {
  PUBLIC
  MEMBERS
}

enum CollaborationRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

model Collaboration {
  id          String                  @id @default(cuid())
  title       String
  description String?
  status      CollaborationStatus     @default(ACTIVE)
  visibility  CollaborationVisibility @default(MEMBERS)
  createdById String
  createdBy   User                    @relation("CollaborationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  members CollaborationMember[]
  threads CollaborationThread[]
  files   CollaborationFile[]
  media   CollaborationMedia[]
  joinRequests JoinRequest[]

  @@index([status, visibility, updatedAt])
  @@index([createdById])
}

model CollaborationMember {
  collaborationId String
  collaboration   Collaboration     @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            CollaborationRole @default(VIEWER)
  joinedAt        DateTime          @default(now())

  @@id([collaborationId, userId])
  @@index([userId])
}

model CollaborationThread {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  title           String
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Comments attach via the polymorphic Comment engine
  // (targetType = collaborationThread, targetId = this id).

  @@index([collaborationId, updatedAt])
}

model CollaborationFile {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  // R2 object key; prefix `members/` (private) or `public/`.
  r2Key           String        @unique
  fileName        String
  contentType     String
  size            Int
  uploadedById    String
  uploadedBy      User          @relation("CollaborationFileUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  annotations CollaborationFileAnnotations?

  @@index([collaborationId, createdAt])
  @@index([uploadedById])
}

// EmbedPDF annotations stored as a single exported blob per file (no per-rect
// schema): exportAnnotations() -> data; importAnnotations(data) on open.
model CollaborationFileAnnotations {
  fileId      String            @id
  file        CollaborationFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  data        Json
  updatedById String
  updatedBy   User              @relation(fields: [updatedById], references: [id], onDelete: Cascade)
  updatedAt   DateTime          @updatedAt
}

model CollaborationMedia {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  // YouTube only in v1 (CSP-allowlisted).
  url             String
  title           String?
  addedById       String
  createdAt       DateTime      @default(now())

  @@index([collaborationId, createdAt])
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  COMMENT_REPLY
  MENTION
  REACTION
  COMMENT_APPROVED
  COLLAB_ACTIVITY
  MESSAGE
  REQUEST
}

model Notification {
  id         String           @id @default(cuid())
  recipientId String
  recipient  User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type       NotificationType
  actorId    String?
  actor      User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  // Polymorphic pointer to the thing the notification is about.
  entityType String?
  entityId   String?
  // Optional human snippet (e.g. comment excerpt) — rendered with i18n shell.
  snippet    String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, createdAt])
}

model NotificationPreference {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOnReply    Boolean @default(true)
  emailOnMention  Boolean @default(true)
  emailOnMessage  Boolean @default(true)
  // Unsubscribe token for one-click email opt-out.
  unsubscribeToken String @unique @default(cuid())
}

// ─── Direct messages ─────────────────────────────────────────────────────────

model Conversation {
  id           String                    @id @default(cuid())
  createdAt    DateTime                  @default(now())
  lastMessageAt DateTime                 @default(now())
  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // For the inbox unread badge: last time this participant read the conversation.
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  reports        MessageReport[]

  @@index([conversationId, createdAt])
}

model MessageReport {
  id         String   @id @default(cuid())
  messageId  String
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String?
  status     CommentReportStatus @default(OPEN)
  createdAt  DateTime @default(now())

  @@unique([messageId, reporterId])
  @@index([status])
}

// ─── Messaging privacy ───────────────────────────────────────────────────────

enum MessagePrivacy {
  EVERYONE // any signed-in member may message
  NOBODY   // closed inbox
}

model UserBlock {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// A one-click follow of a region, theme, or project (no approval). `targetId`
// is the polymorphic key: a regional-community slug (REGION), a theme/tag value
// (THEME), or a Collaboration id (PROJECT). One row per (user, type, target).
model Follow {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType FollowTargetType
  targetId   String
  createdAt  DateTime         @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

enum FollowTargetType {
  REGION
  THEME
  PROJECT
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// A member's request to join a collaboration workspace. On ACCEPT the requester
// is added as a CollaborationMember (VIEWER). Owners are notified (REQUEST).
model JoinRequest {
  id              String        @id @default(cuid())
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  requesterId     String
  requester       User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  message         String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  resolvedAt      DateTime?

  // One open request per (collaboration, requester); resolved ones are kept for history
  @@unique([collaborationId, requesterId])
  @@index([collaborationId, status])
  @@index([requesterId])
}

// A request from one member to connect/contact another. On ACCEPT the recipient
// has opted into being contacted by the requester.
model ContactRequest {
  id          String        @id @default(cuid())
  requesterId String
  requester   User          @relation("ContactRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User          @relation("ContactRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  message     String?
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
}
