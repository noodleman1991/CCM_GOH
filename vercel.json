    { "source": "/guide-to-editors", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/guide-to-editors/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
