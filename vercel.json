{
  "regions": ["lhr1"],
  "headers": [
    { "source": "/guide-to-editors", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/guide-to-editors/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "crons": [
    { "path": "/api/cron/event-reminders", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/weekly-digest", "schedule": "0 8 * * 1" },
    { "path": "/api/cron/retention", "schedule": "0 3 * * 0" }
  ]
}
